# 실제 값을 채운 뒤 .env 로 복사해서 사용한다. 이 파일에는 비밀값을 넣지 않는다.

DATABASE_URL=postgresql://user:password@localhost:5432/dbname
REDIS_URL=redis://localhost:6379/0

# openssl rand -hex 32 로 생성
SECRET_KEY=

# SOLAPI (문자 인증) — 실제 발송 시 요금이 부과된다
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_PHONE=

# Google AI Studio 에서 발급
GEMINI_API_KEY=

# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성
# 내려받은 JSON 을 이 경로에 두면 된다 (기본값: firebase-credentials.json)
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
